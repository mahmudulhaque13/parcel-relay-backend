# ============================================================
# ParcelRelay Backend — Environment Variables (EXAMPLE)
# Copy this file to `.env` and fill in real values locally.
# NEVER commit a real `.env` file or real secrets.
# ============================================================

# ---- Application ----
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed CORS origins (no wildcard in production)
CORS_ORIGINS=http://localhost:3000

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/parcelrelay?schema=public"

# ---- JWT (used in later phases) ----
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ---- Google OAuth (used in later phases) ----
GOOGLE_CLIENT_ID=replace_with_google_client_id


# ---- SSLCommerz payment (used in later phases) ----
SSL_STORE_ID=replace_with_store_id
SSL_STORE_PASSWORD=replace_with_store_password
SSL_IS_LIVE=false

# ---- Redis (used in later phases) ----
REDIS_URL=redis://localhost:6379

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

BCRYPT_SALT_ROUNDS=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

STRIPE_SUCCESS_URL=http://localhost:5000/api/v1/payments/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5000/api/v1/payments/cancel



ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
