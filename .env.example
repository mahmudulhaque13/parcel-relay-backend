# ---- Application ----
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
DATABASE_URL=

# ---- JWT ----
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=replace_with_google_client_id

# ---- Redis ----
REDIS_USER=default
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

BCRYPT_SALT_ROUNDS=10

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5000/api/v1/payments/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5000/api/v1/payments/cancel

# ---- Admin Seed ----
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Email ----
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=