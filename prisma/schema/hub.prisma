model Hub {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  address     String
  zoneId      String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  outgoingTransfers ShipmentTransfer[] @relation("FromHubTransfers")
  incomingTransfers ShipmentTransfer[] @relation("ToHubTransfers")

  @@index([zoneId])
  @@map("hubs")
}