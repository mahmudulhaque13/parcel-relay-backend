model PricingRule {
  id            String   @id @default(uuid())
  name          String
  basePrice     Decimal  @db.Decimal(10, 2)
  perKgPrice    Decimal  @db.Decimal(10, 2)
  codPercentage Decimal  @db.Decimal(5, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shipments Shipment[] @relation("PricingRuleShipments")

  @@map("pricing_rules")
}