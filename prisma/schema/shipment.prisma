model Shipment {
  id                String         @id @default(uuid())
  trackingNumber    String         @unique

  customerId        String
  originZoneId      String
  destinationZoneId String
  pricingRuleId     String?

  recipientName     String
  recipientPhone    String
  deliveryAddress   String

  packageDescription String
  weight             Decimal        @db.Decimal(10, 2)

  deliveryCharge    Decimal        @db.Decimal(10, 2)
  codAmount         Decimal        @db.Decimal(10, 2) @default(0)

  status            ShipmentStatus @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus  @default(PENDING)

  isDeleted         Boolean        @default(false)
  deletedAt         DateTime?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  customer          User           @relation("CustomerShipments", fields: [customerId], references: [id], onDelete: Restrict)
  originZone        Zone           @relation("OriginZoneShipments", fields: [originZoneId], references: [id], onDelete: Restrict)
  destinationZone   Zone           @relation("DestinationZoneShipments", fields: [destinationZoneId], references: [id], onDelete: Restrict)
  pricingRule       PricingRule?   @relation("PricingRuleShipments", fields: [pricingRuleId], references: [id], onDelete: SetNull)

  pickupRequest     PickupRequest?

  transfers         ShipmentTransfer[]

  events            ShipmentEvent[]

  paymentAttempts   PaymentAttempt[]

  courierId         String?

  courier           CourierProfile? @relation("CourierShipments", fields: [courierId], references: [id], onDelete: SetNull)

  @@index([customerId, status, createdAt])
  @@index([courierId, status])
  @@index([originZoneId, destinationZoneId])
  @@index([status, createdAt])
  @@index([pricingRuleId])
  @@index([originZoneId])
  @@index([destinationZoneId])
  @@index([paymentStatus])

  @@map("shipments")
}